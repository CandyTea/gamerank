[Unit]
Description=GameRank live rankings
After=network.target

[Service]
Type=simple
User=gamerank
Group=gamerank
WorkingDirectory=/opt/gamerank
Environment=PYTHONUNBUFFERED=1
Environment=GAMERANK_HOST=0.0.0.0
Environment=GAMERANK_PORT=8080
EnvironmentFile=-/etc/default/gamerank
ExecStart=/usr/bin/python3 /opt/gamerank/server/gamerank_server.py \
    --host ${GAMERANK_HOST} --port ${GAMERANK_PORT} \
    --db /var/lib/gamerank/boards.db \
    --static /opt/gamerank
Restart=always
RestartSec=3
StateDirectory=gamerank
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gamerank

[Install]
WantedBy=multi-user.target
