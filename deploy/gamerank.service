[Unit]
Description=GameRank shared-board API
After=network.target

[Service]
Type=simple
User=gamerank
Group=gamerank
WorkingDirectory=/opt/gamerank
# Change this secret; it is the password the browser sends as X-GameRank-Token.
Environment=GAMERANK_TOKEN=CHANGE_ME
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/gamerank/server/gamerank_server.py \
    --host 127.0.0.1 --port 8787 \
    --db /var/lib/gamerank/boards.db \
    --static /opt/gamerank
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gamerank

[Install]
WantedBy=multi-user.target
